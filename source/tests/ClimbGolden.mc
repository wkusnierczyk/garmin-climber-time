using Toybox.Test;

import Toybox.Lang;

// Golden values from the browser simulator (design/climber-time-simulator.html), the
// behavioural reference: the watch has to reproduce its routes exactly (DESIGN.md §15.3,
// §17.2). Taken 2026-11-15 on the 416 x 416 round screen, floating panel, the defaults of
// §14.3, from minute BASE (an hour boundary) on. Regenerate them from the simulator after
// any change to the route rules, never by copying the watch's output.
(:test)
module ClimbGolden {

    const BASE = 29462400;
    const TOL = 0.05;               // px; the watch computes in 32-bit floats

    function geom() as Geom {
        return new Geom(416, 416, true, Climb.LAYOUT_PANEL, true);
    }

    function near(a as Float, b as Float) as Boolean {
        return (a - b).abs() <= TOL;
    }

