# Build output: make build and make test write the .prg files, their .prg.debug.xml and
# monkeyc's gen/ and *-mir/ folders; make export writes export/. make clean removes all of it.
gen/
internal-mir/
external-mir/
export/
*.prg
*.prg.*

# monkeyc writes <prg>-settings.json beside a .prg once the app has settings (none yet; as in
# wkusnierczyk/garmin-matrix-time#32).
ClimberTime*-settings.json
test_build-settings.json

# make graphics' hero drafts. The published hero, ClimberTimeHero.png, is composed separately by an
# image model from make preview's renders, with tools/hero-prompt.txt (#8).
store/lite/graphics/*-draft*.png

# Safeguards rather than outputs: editor settings, system files and the key.
# IDE/Editor settings
.settings/
.project
.cproject
.vscode/

# System files
.DS_Store

# Developer key (CRITICAL: never commit this)
developer_key*
