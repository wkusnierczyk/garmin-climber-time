# Build output: make build and make test write the .prg files, their .prg.debug.xml and
# monkeyc's gen/ and *-mir/ folders; make export writes export/. make clean removes all of it.
gen/
internal-mir/
external-mir/
export/
*.prg
*.prg.*

# monkeyc writes <prg>-settings.json beside a .prg once the app has settings (none in Lite
# 0.1.0; as in wkusnierczyk/garmin-matrix-time#32).
ClimberTime*-settings.json
test_build-settings.json

# IDE/Editor settings
.settings/
.project
.cproject
.vscode/

# System files
.DS_Store
Thumbs.db

# Developer key (CRITICAL: never commit this)
developer_key*

# Python bytecode (tools/make-help.py)
__pycache__/
