# Prototype: one edition, one product. The Lite/Premium split comes with the real face.
project.manifest = manifest.xml

# Strict typing from the first line (playbook, reference/build.md).
project.typecheck = 3

# Name the source directory: the default globs .dev/ too.
base.sourcePath = source

# The launcher icons, one resource path per product (#19): the icon size is per device,
# not per device family. Regenerate with make icons rather than the command recorded
# below, which leaves out the store cover.

# BEGIN generated launcher icon mapping -- garmin-graphics-generator
# Launcher icon size is per device, not per device family.
# Regenerate with: garmin-graphics-generator icons -R tools/launcher_icon.py --readme docs/graphics.md --readme-anchor 'Each supported product is mapped to the icon its device asks for'
